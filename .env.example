# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# URL pública de la app (se usa en los códigos QR del menú). Ej.: https://pos.tudominio.com
NEXT_PUBLIC_APP_URL=

# Facturación electrónica: clave para cifrar credenciales de proveedores (cualquier
# texto largo y aleatorio; si cambia, hay que volver a guardar las credenciales).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EINVOICE_ENCRYPTION_KEY=

# Protege /api/cron/einvoice (Vercel Cron envía Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Sólo servidor: alta de personal y claves API de agentes. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Agente Analista (Admin → Análisis): clave de la API de Anthropic (console.anthropic.com).
# Sólo servidor. Sin ella, el tablero de análisis funciona pero el informe con IA queda desactivado.
ANTHROPIC_API_KEY=
# Plan de IA para gastrobares sin plan asignado en tenant_ai_plans
# (sin_ia | prueba | basico | pro | premium; por defecto prueba). Ver lib/ai/plans.ts.
DEFAULT_AI_PLAN=
# Opcionales: fijar un modelo para todos los informes (ignora el enrutador Haiku/Sonnet)
# y el esfuerzo de razonamiento de Sonnet (low | medium | high; por defecto medium).
ANALYST_MODEL=
ANALYST_EFFORT=

# Mensajero: correo con Resend (resend.com, gratis 3.000/mes). Usa una clave de "solo envío".
RESEND_API_KEY=
# Remitente. Sin dominio verificado en Resend se usa onboarding@resend.dev, que sólo
# puede enviar al correo dueño de la cuenta. Con dominio: "GastroBar <resumen@tudominio.com>".
RESEND_FROM=
